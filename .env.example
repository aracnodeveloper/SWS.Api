# Copia a .env y completa. No commitear secretos.
# Las claves usan la convención de ASP.NET Core: Seccion__Clave.

POSTGRES_PASSWORD=swspass

# Seguridad (obligatorios en producción; la API no arranca sin JWT__SecretKey)
JWT__SecretKey=
Password__Salt=
Password__Pepper=

# Usuario administrador inicial (se crea solo si no existe ningún usuario)
Admin__Email=worldsale0925@gmail.com
Admin__Password=

# Orígenes del front (CORS) y URL pública de la tienda (retorno de PayPhone)
AppOptions__WebUrl=https://saleworldsale.com
AppOptions__PublicWebUrl=https://saleworldsale.com

# PayPhone — Developer > Configuración en https://appdeveloper.payphonetodoesposible.com
PayPhone__Token=
PayPhone__StoreId=

# Correo transaccional (confirmación de pedidos). Gmail: usar contraseña de aplicación.
Smtp__User=
Smtp__Pass=
Smtp__From=
